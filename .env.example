# ---------------------------------------------------------------------------
# Wrong but Useful -- configuration template
#
# Copy to .env, fill in, and load it:   set -a && . ./.env && set +a
# .env is gitignored. NEVER commit it, and never paste a filled-in copy into an
# issue -- `python scripts/dry_run.py` prints the same picture with the secrets
# withheld, and is the right thing to paste.
#
# Every value below is EMPTY by default in code. There is no fallback endpoint:
# an unconfigured run skips loudly rather than sending your traffic somewhere
# you did not choose.
# ---------------------------------------------------------------------------

# --- Model identity, per role ---------------------------------------------
# Resolution order, most specific first:
#   DHD_<ROLE>_*   ->   DHD_ACTOR_*   ->   MODEL_API_*
#
# DHD_ACTOR_* covers recruiter + hypothesizer + integrator (the actor family).
# The EVALUATOR IS DELIBERATELY NOT IN THAT LANE. The paper scores every actor
# family with a separate evaluator, so setting only the actor lane leaves the
# evaluator unset -- which is correct, and the run will tell you.

DHD_ACTOR_BASE_URL=
DHD_ACTOR_API_KEY=
DHD_ACTOR_MODEL=

DHD_EVALUATOR_BASE_URL=
DHD_EVALUATOR_API_KEY=
DHD_EVALUATOR_MODEL=

# Override individual roles only if they differ from the lane above.
# DHD_RECRUITER_BASE_URL=
# DHD_RECRUITER_API_KEY=
# DHD_RECRUITER_MODEL=
# DHD_HYPOTHESIZER_BASE_URL=
# DHD_HYPOTHESIZER_API_KEY=
# DHD_HYPOTHESIZER_MODEL=
# DHD_INTEGRATOR_BASE_URL=
# DHD_INTEGRATOR_API_KEY=
# DHD_INTEGRATOR_MODEL=

# --- Legacy single-model fallback -----------------------------------------
# The names the published arXiv artifact used. They still work as a global
# fallback. On their own, though, they are exactly the collapsed configuration
# that this repository rejects for a config declaring two model slots: one
# identifier cannot serve both the actor and a separate evaluator. Prefer the
# per-role names above.
# MODEL_API_BASE=
# MODEL_API_KEY=
# MODEL_API_MODEL=
# MODEL_API_TIMEOUT_S=120

# --- Assertions (recommended in scripted runs) -----------------------------
# If set, the resolved identifier for that role must match EXACTLY or the run
# aborts before issuing a single call. Cheap insurance against a stale variable
# silently running the wrong model for hours.
# DHD_EXPECT_INTEGRATOR_MODEL=
# DHD_EXPECT_EVALUATOR_MODEL=
# DHD_EXPECT_RECRUITER_MODEL=
# DHD_EXPECT_HYPOTHESIZER_MODEL=

# --- Paths (all default to repository-relative locations) ------------------
# DHD_DATA_ROOT=./data
# DHD_CACHE_DIR=./.dhd_cache
# DHD_OUTPUT_DIR=./outputs
# DHD_ANALYSIS_INPUT_DIR=./data/derived
# DHD_ANALYSIS_OUTPUT_DIR=./reproduced

# --- Run parameters --------------------------------------------------------
# DHD_DATASET_ID=AgentsSci/AAAI_Wrong-but-Useful
# DHD_BENCHMARK=smoke_fixture
# DHD_SAMPLE_LIMIT=0          # 0 = no limit
# DHD_REPLICATES=1
# DHD_SEED=20260717           # seeds label bootstraps only; see below

# --- Transport -------------------------------------------------------------
# DHD_CONCURRENCY=1
# DHD_MAX_RETRIES=2
# DHD_RETRY_BACKOFF_S=2.0
# DHD_TIMEOUT_S=120

# --- Decoding overrides ----------------------------------------------------
# Per-role temperature and max_tokens come from the protocol config. Override
# them here only to work around an endpoint that rejects the paper's settings;
# doing so means you are no longer running the paper's decoding.
# DHD_TEMPERATURE_OVERRIDE=
# DHD_MAX_TOKENS_OVERRIDE=

# ---------------------------------------------------------------------------
# On seeds: DHD_SEED controls the bootstrap resampling in label aggregation and
# the schedule shuffle, both of which are deterministic. It does NOT make model
# generation reproducible -- the OpenAI-compatible surface used here exposes no
# seed parameter, and the hosted services used for the paper did not expose
# weight-revision hashes. Generated text is not promised byte-identical.
# ---------------------------------------------------------------------------
